# Inheritance Engine configuration. Copy to .env and adjust. Nothing here is required for local use.

# --- Model (open-weight, local by default) ---
# openai-compatible: LM Studio, llama.cpp server, vLLM, any /v1/chat/completions endpoint
# ollama: Ollama's native API
IE_MODEL_PROVIDER=openai-compatible
IE_MODEL_ENDPOINT=http://127.0.0.1:1234/v1
IE_MODEL=google/gemma-4-e4b
# IE_MODEL_API_KEY=            # only for endpoints that need one; never logged or passed to inherited code
# IE_MODEL_CONTEXT=16384       # num_ctx for Ollama
# IE_MODEL_TEMPERATURE=0.2
# IE_MODEL_TIMEOUT_SECS=600
# IE_MODEL_THINK=0             # Ollama reasoning toggle for models that support it (e.g. qwen3)

# Per-agent overrides, e.g. a larger model for the independent reviewer:
# IE_MODEL_REVIEWER=google/gemma-4-12b-qat
# IE_MODEL_LEAD=
# IE_MODEL_HISTORIAN=
# IE_MODEL_RESTORER=
# IE_MODEL_HUNTER=

# --- Privacy ---
# local_only (default): repository content only goes to loopback model endpoints
# cloud_with_permission: remote endpoints allowed only when IE_ALLOW_CLOUD=1
# cloud_first: remote endpoints allowed
IE_PRIVACY_MODE=local_only
# IE_ALLOW_CLOUD=0

# --- GitHub (optional) ---
# A token with NO scopes is enough; it only raises the public API rate limit for search.
# GITHUB_TOKEN=

# --- Execution sandbox ---
# IE_PYTHON_IMAGE=python:3.12-slim
# IE_NODE_IMAGE=node:22-slim
# IE_RUN_TIMEOUT_SECS=600
# IE_MAX_REPO_KB=150000

# --- Server ---
# IE_BIND=127.0.0.1:7878       # keep on loopback; the API has no user accounts
# IE_DATA_DIR=data
# IE_LOG_JSON=1                # structured JSON logs
